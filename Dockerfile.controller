FROM --platform=$BUILDPLATFORM golang:1.24 AS builder

ARG TARGETARCH

WORKDIR /go/src/app
COPY go.mod .
COPY go.sum .
RUN go mod download
COPY . .

# Build statically linked binary
ENV CGO_ENABLED=0
RUN make build-controller GOARCH=$TARGETARCH

# The approach here is to copy all libraries that ldd reports
    # Sample ldd output on x86_64
    #  linux-vdso.so.1 (0x00007fff123456789) - provided in all linux arches, no need to copy  
    #  libresolv.so.2 => /lib/x86_64-linux-gnu/libresolv.so.2 (0x00007f1234567890)
    #  libc.so.6 => /lib/x86_64-linux-gnu/libc.so.6 (0x00007f1234567890)
    #  /lib64/ld-linux-x86-64.so.2 (0x00007f1234567890)
RUN mkdir -p /runtime-deps && \
    ldd /go/src/app/skupper | grep -o '/\S*' | while IFS= read -r lib_path; do \
        dest_dir="/runtime-deps/${lib_path%/*}"; \
        mkdir -p "$dest_dir"; \
        cp "$lib_path" "$dest_dir"; \
        echo "Copied: $lib_path"; \
    done

# Generate multiple SBOM formats
FROM alpine:latest AS sbom-generator
RUN apk add --no-cache curl
RUN curl -sSfL https://raw.githubusercontent.com/anchore/syft/main/install.sh | sh -s -- -b /usr/local/bin
COPY --from=builder /go/src/app /src
RUN syft packages dir:/src -o spdx-json=/tmp/sbom.spdx.json
RUN syft packages dir:/src -o cyclonedx-json=/tmp/sbom.cyclonedx.json
RUN syft packages dir:/src -o syft-json=/tmp/sbom.syft.json

# Use scratch for minimal image size
FROM scratch

LABEL \
  org.opencontainers.image.title="Skupper Controller" \
  org.opencontainers.image.description="Kubernetes controller for operating skupper networks" \
  org.opencontainers.image.sbom.spdx="/sbom/sbom.spdx.json" \
  org.opencontainers.image.sbom.cyclonedx="/sbom/sbom.cyclonedx.json" \
  org.opencontainers.image.sbom.syft="/sbom/sbom.syft.json"
# Copy the collected files from the /runtime-deps folder from the builder
COPY --from=builder /runtime-deps /

WORKDIR /app

# Copy the statically linked binary
COPY --from=builder /go/src/app/controller .

# Copy SBOMs for different scanner compatibility
COPY --from=sbom-generator /tmp/sbom.spdx.json /sbom/sbom.spdx.json
COPY --from=sbom-generator /tmp/sbom.cyclonedx.json /sbom/sbom.cyclonedx.json
COPY --from=sbom-generator /tmp/sbom.syft.json /sbom/sbom.syft.json

# Use numeric user ID (no need to create user in scratch)
USER 10000

CMD ["/app/controller"]
